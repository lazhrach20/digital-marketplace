# PostgreSQL connection (matches docker-compose db service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace

# HTTP port for the API
PORT=3000

# Provider issue call timeout (ms)
PROVIDER_TIMEOUT_MS=3000

# Primary provider (A): retry count after timeout
PROVIDER_A_RETRIES=2

# Primary provider (A): simulated error rate 0–1 (0 = disabled)
PROVIDER_A_ERROR_RATE=0

# Primary provider (A): simulated timeout rate 0–1 (0 = disabled)
PROVIDER_A_TIMEOUT_RATE=0

# Primary provider (A): deterministic test flags (T6/T7/scripts; set to 1 to enable)
# PROVIDER_A_FORCE_TIMEOUT_THEN_OK=1  # first call times out after issue; retry same request_id → same code
# PROVIDER_A_ALWAYS_DOWN=1            # every call returns 5xx (A unavailable → fallback B)

# Fallback provider (B): simulated error rate 0–1 (0 = disabled)
PROVIDER_B_ERROR_RATE=0
